generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Multi-tenancy ----

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users       User[]
  workflows   Workflow[]
  credentials Credential[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  role           String   @default("owner") // owner | admin | member
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

// ---- Workflows ----

model Workflow {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Graph definition: nodes + connections, editor-agnostic JSON
  definition Json
  active     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions   Execution[]
  webhookPaths WebhookPath[]

  @@index([organizationId])
}

model WebhookPath {
  id         String   @id @default(cuid())
  path       String   @unique // public URL slug: /webhook/:path
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeId     String   // which node in the definition this maps to
  method     String   @default("POST")
  createdAt  DateTime @default(now())
}

model Execution {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status    String   @default("running") // running | success | error | waiting
  trigger   String   // manual | webhook | schedule
  input     Json?
  output    Json?
  error     String?
  nodeLogs  Json?    // per-node execution trace for debugging

  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  @@index([workflowId])
}

model Credential {
  id             String   @id @default(cuid())
  name           String
  type           String   // e.g. "anthropic", "openai", "slack", "smtp", "httpHeaderAuth"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // AES-256-GCM encrypted JSON blob, never returned to client in plaintext
  encryptedData String

  createdAt DateTime @default(now())

  @@index([organizationId])
}
